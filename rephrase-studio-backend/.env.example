# Simpan nilai asli hanya di .env atau secret manager. Jangan commit API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
REQUEST_TIMEOUT_MS=45000
MAX_INPUT_CHARS=12000
ALLOWED_ORIGIN=http://localhost:5173
# true: backend juga melayani build rephrase-studio-web/dist
SERVE_FRONTEND=false
# FRONTEND_DIST=/absolute/path/to/rephrase-studio-web/dist
